# Added automatically by a Vercel Postgres marketplace integration such as Neon.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate a different 32-byte base64 value for each secret.
# Example PowerShell command:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
REPORT_ENCRYPTION_KEY=replace-with-32-byte-base64-key
RATE_LIMIT_SECRET=replace-with-another-32-byte-base64-key

# Added automatically after connecting a Private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Reviewer sessions are server-side and use this cookie lifetime in hours.
REVIEWER_SESSION_HOURS=12
REPORTER_SESSION_HOURS=2
