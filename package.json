{
  "name": "silentsignals",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @silentsignals/web dev",
    "build": "pnpm --filter @silentsignals/web build",
    "start": "pnpm --filter @silentsignals/web start",
    "lint": "pnpm --filter @silentsignals/web lint",
    "typecheck": "pnpm --filter @silentsignals/web typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build"
  }
}
